#!/usr/bin/env bash
# Doc gate: refuses a commit when the tracker at the top of PROJECT.md or the router CLAUDE.md breaks its size ceilings
# (tracker 40 non-blank lines and 250 characters per line; router 80 non-blank lines). Mechanical on purpose: Adam,
# 2026-10-06: "can we actually make it happen in practice, always, every time". Checks only when PROJECT.md or CLAUDE.md
# is staged, and reads the staged version, so what is committed is what is judged. Installed from tools/hooks/pre-commit
# into the folder git runs hooks from by tools/session_start.sh (which finds its "# Doc gate:" signature line above).
# Also prints a non-blocking nudge naming any new ruling numbers when DECISIONS.md is staged (exit code unchanged).
# Also prints, once per audit date per project, the rules repo's latest "Weekly audit" line (non-blocking, every commit).
# A repo with a .doc-gate-skip-router file at its root is not gated on CLAUDE.md (the rules repo, whose CLAUDE.md is the global rules file).
# Never bypass it with --no-verify (global rules).
# The tracker-section rule below is identical to the one in tools/session_start.sh; change both together:
#   the tracker is line 1 up to the line before the first "<!-- tracker ends -->" line; with no such line, up to the
#   line before the first "## " heading that does not name a tracker section (the whole words Done since, In progress,
#   Next, Waiting on Adam or Watch, in any case, or a heading that starts with Tracker, optionally after "Part N -");
#   with neither, the whole file. Blank lines are not counted.
# Characters are counted as UTF-8 code points without relying on the locale: under LC_ALL=C strip the continuation
# bytes (0x80-0xBF) and take the length, so an emoji counts once in any awk.
TRACKER_MAX=40; LINE_MAX=250; ROUTER_MAX=80
[ -f .doc-gate-skip-router ] && ROUTER_MAX=999999
staged=$(git diff --cached --name-only 2>/dev/null)
fails=0
say() { echo "$1"; fails=$((fails + 1)); }

if printf '%s\n' "$staged" | grep -qx 'PROJECT.md'; then
  res=$(git show :PROJECT.md 2>/dev/null | tr -d '\r' | LC_ALL=C awk -v max="$LINE_MAX" '
    function clen(s) { gsub(/[\200-\277]/, "", s); return length(s) }
    { line[NR] = $0 }
    END {
      end = NR; mk = 0
      for (i = 1; i <= NR; i++) if (line[i] ~ /^<!-- tracker ends -->/) { mk = i; break }
      if (mk) end = mk - 1
      else for (i = 1; i <= NR; i++) {
        h = tolower(line[i])
        if (line[i] ~ /^## / && h !~ /(^|[^a-z0-9])(done since|in progress|next|waiting on adam|watch)([^a-z0-9]|$)/ \
            && h !~ /^## (part [0-9]+[^a-z0-9]+)?tracker([^a-z0-9]|$)/) { end = i - 1; break }
      }
      n = 0
      for (i = 1; i <= end; i++) {
        if (line[i] ~ /^[ \t]*$/) continue
        n++
        l = clen(line[i])
        if (l > max) printf "LONG %d %d\n", i, l
      }
      printf "COUNT %d\n", n
    }')
  n=$(printf '%s\n' "$res" | sed -n 's/^COUNT //p')
  [ -n "$n" ] && [ "$n" -gt "$TRACKER_MAX" ] && say "PROJECT.md tracker has $n lines (ceiling $TRACKER_MAX): move finished items to ARCHIVE.md"
  while read -r tag ln len; do
    [ "$tag" = "LONG" ] && say "PROJECT.md:$ln is $len characters (max $LINE_MAX): keep the what and where here, move the detail to ARCHIVE.md or a DECISIONS.md entry and point to it"
  done <<< "$res"
fi

if printf '%s\n' "$staged" | grep -qx 'CLAUDE.md'; then
  n=$(git show :CLAUDE.md 2>/dev/null | tr -d '\r' | LC_ALL=C grep -c '[^[:space:]]')
  [ "$n" -gt "$ROUTER_MAX" ] && say "CLAUDE.md has $n lines (ceiling $ROUTER_MAX): move detail to DECISIONS.md or README.md and keep the router short"
fi

# Filing-time nudge (never blocks, never changes the exit code): when DECISIONS.md is staged, name the ruling numbers
# that are in the staged file and not in HEAD's (all of them when HEAD has no DECISIONS.md).
if printf '%s\n' "$staged" | grep -qx 'DECISIONS.md'; then
  newd=$(comm -13 \
    <(git show HEAD:DECISIONS.md 2>/dev/null | tr -d '\r' | grep -oE '^(- )?D[0-9]+' | grep -oE 'D[0-9]+' | sort -u) \
    <(git show :DECISIONS.md 2>/dev/null | tr -d '\r' | grep -oE '^(- )?D[0-9]+' | grep -oE 'D[0-9]+' | sort -u) \
    | sort -V | paste -sd, - | sed 's/,/, /g')
  [ -n "$newd" ] && printf '%s\n' "New rulings staged: $newd. Check each against the global rules (the global CLAUDE.md in ~/.claude) before pushing; a conflict is raised to Adam, never filed silently (global rules, Records)."
fi

# Weekly audit notice (never blocks, never changes the exit code, runs on every commit): the scheduled audit files one
# "- Weekly audit <date>: ..." line in the rules repo's tracker; conversations never reload, so this prints it once
# per audit date per project (marker: doc-gate-weekly-seen in the git dir, never tracked). Every failure is silent.
RULES_TRACKER="${DOC_GATE_RULES_TRACKER:-$HOME/claude-rules/PROJECT.md}"
if [ -f "$RULES_TRACKER" ]; then
  wk=$(grep -m1 -E '^- Weekly audit [0-9]{4}-[0-9]{2}-[0-9]{2}:' "$RULES_TRACKER" 2>/dev/null | tr -d '\r')
  if [ -n "$wk" ]; then
    wkd=${wk#- Weekly audit }; wkd=${wkd:0:10}
    seen=$(git rev-parse --git-path doc-gate-weekly-seen 2>/dev/null)
    if [ -n "$seen" ] && [ "$(cat "$seen" 2>/dev/null)" != "$wkd" ]; then
      printf 'Rules: %s\n  (paste blocks for this project, if any, are in ~/claude-rules/handoff/weekly/)\n' "${wk#- }"
      { printf '%s\n' "$wkd" > "$seen"; } 2>/dev/null
    fi
  fi
fi

if [ "$fails" -gt 0 ]; then
  echo "Commit refused by the doc gate (tools/hooks/pre-commit). Fix the lines above; do not use --no-verify (global rules)."
  exit 1
fi
exit 0
